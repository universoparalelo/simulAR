# Copiar este archivo a .env y completar con los valores reales.
# .env NO se versiona (ver .gitignore) porque puede contener credenciales.

# Sin esta variable, la app usa SQLite local (sqlite:///./simular_local.db).
# DATABASE_URL=sqlite:////ruta/personalizada/simular.db

# Ruta en el host donde están las simulaciones (para docker compose)
# SIMULACIONES_PATH=/ruta/a/las/simulaciones
