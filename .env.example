# Copiar este archivo a .env y completar con las credenciales reales.
# .env NO se versiona (ver .gitignore) porque contiene la contraseña de la DB.

# Sin esta variable, la app usa SQLite local (sqlite:///./simular_local.db).
# Para apuntar a Supabase, pegar acá el connection string del modo "Session pooler"
# (Project → botón "Connect" → Session pooler), reemplazando [PASSWORD]:
DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres
